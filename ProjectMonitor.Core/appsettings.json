{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Monitor": {
    "GitHubOwner": "Bregann",
    "UptimeTimeoutSeconds": 10,
    "UptimeRetentionDays": 30,
    "FailuresBeforeDown": 2,
    "ReportedValueRetentionDays": 30
  }
}
