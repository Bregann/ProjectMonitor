@inherits DashboardComponentBase

<MudTooltip Text="@($"GitHub: {Format.Ago(State.LastGitHubPollUtc, NowUtc)} · Uptime: {Format.Ago(State.LastUptimeCheckUtc, NowUtc)}")">
    <MudText Typo="Typo.caption" Class="mr-2 last-updated">
        <span class="status-dot @(State.LastGitHubPollUtc is null ? "pending" : "healthy")"></span>
        Updated @Format.Ago(Latest, NowUtc)
    </MudText>
</MudTooltip>

@code {
    private DateTime? Latest => new[] { State.LastGitHubPollUtc, State.LastUptimeCheckUtc }.Max();
}
