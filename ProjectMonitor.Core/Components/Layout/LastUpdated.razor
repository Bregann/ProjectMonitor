@inherits DashboardComponentBase

<MudTooltip Text="@($"GitHub: {Format.Ago(_freshness.LastGitHubPollUtc, NowUtc)} · Uptime: {Format.Ago(_freshness.LastUptimeCheckUtc, NowUtc)}")">
    <MudText Typo="Typo.caption" Class="mr-2 last-updated">
        <span class="status-dot @(_freshness.LatestUtc is null ? "pending" : "healthy")"></span>
        Updated @Format.Ago(_freshness.LatestUtc, NowUtc)
    </MudText>
</MudTooltip>

@code {
    private DataFreshnessDto _freshness = new();

    protected override void LoadData()
    {
        _freshness = Dashboard.GetDataFreshness();
    }
}
