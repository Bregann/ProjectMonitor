@inherits DashboardComponentBase

<MudNavMenu Class="pt-2">
    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">At a glance</MudNavLink>
    <MudText Typo="Typo.overline" Class="px-4 pt-4 pb-1 nav-heading">Projects</MudText>
    @foreach (NavProjectDto project in _projects)
    {
        <MudNavLink Href="@($"/projects/{project.Slug}")" Match="NavLinkMatch.Prefix">
            <span class="d-flex align-center gap-2">
                <span class="status-dot @(project.HasData ? project.Level.ToString().ToLowerInvariant() : "pending")"></span>
                @project.Name
            </span>
        </MudNavLink>
    }
    <MudDivider Class="my-2" />
    <MudNavLink Href="/manage" Icon="@Icons.Material.Filled.Tune">Manage projects</MudNavLink>
    <MudNavLink Href="/hangfire" Target="_blank" Icon="@Icons.Material.Filled.Schedule">Background jobs</MudNavLink>
</MudNavMenu>

@code {
    private List<NavProjectDto> _projects = [];

    protected override void LoadData()
    {
        _projects = Dashboard.GetNavProjects();
    }
}
